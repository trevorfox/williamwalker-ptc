{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/calendar.ics",
      "destination": "/api/calendar?format=ics"
    },
    {
      "source": "/calendar-:only.ics",
      "destination": "/api/calendar?format=ics&only=:only"
    }
  ],
  "redirects": [
    {
      "source": "/parents",
      "destination": "/families",
      "permanent": true
    },
    {
      "source": "/blog/school-cents",
      "destination": "/blog/school-cents-october",
      "permanent": true
    },
    {
      "source": "/meeting-link",
      "destination": "https://meet.google.com/qsu-qztm-vqw",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.williamwalkerptc.com"
        }
      ],
      "destination": "https://williamwalkerptc.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.williamwalkerptc.com"
        }
      ],
      "destination": "https://williamwalkerptc.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wwptc.org"
        }
      ],
      "destination": "https://williamwalkerptc.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wwptc.org"
        }
      ],
      "destination": "https://williamwalkerptc.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.wwptc.org"
        }
      ],
      "destination": "https://williamwalkerptc.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.wwptc.org"
        }
      ],
      "destination": "https://williamwalkerptc.com/:path*",
      "permanent": true
    }
  ]
}
